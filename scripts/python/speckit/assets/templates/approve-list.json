{
  "description": "Shared auto-approve patterns for Spec Kit CLI commands and tools",
  "note": "This list is injected into AI agent configs (VS Code Copilot, Claude) during setup",
  "patterns": [
    "speckitadv",
    "speckitadv *",
    "pip install speckitadv",
    "pipx install speckitadv",
    "uv tool install speckitadv",
    "uvx speckitadv",

    "git status",
    "git diff",
    "git diff *",
    "git log",
    "git log *",
    "git branch",
    "git branch *",
    "git ls-remote",
    "git ls-remote *",
    "git fetch",
    "git fetch *",
    "git checkout",
    "git checkout *",
    "git add",
    "git add *",
    "git commit",
    "git commit *",
    "git push",
    "git push *",
    "git pull",
    "git pull *",
    "git stash",
    "git stash *",
    "git show",
    "git show *",
    "git rev-parse",
    "git rev-parse *",
    "git ls-files",
    "git ls-files *",
    "git remote",
    "git remote *",

    "ls",
    "ls *",
    "ls -la",
    "ls -la *",
    "pwd",
    "cd",
    "cd *",
    "mkdir",
    "mkdir *",
    "mkdir -p",
    "mkdir -p *",
    "cat",
    "cat *",
    "grep",
    "grep *",
    "echo",
    "echo *",
    "head",
    "head *",
    "tail",
    "tail *",
    "find",
    "find *",
    "which",
    "which *",

    "pip",
    "pip *",
    "pip3",
    "pip3 *",
    "python",
    "python *",
    "python3",
    "python3 *",
    "pytest",
    "pytest *",

    "npm",
    "npm *",
    "yarn",
    "yarn *",
    "pnpm",
    "pnpm *",

    "uv",
    "uv *",
    "uvx",
    "uvx *"
  ]
}
